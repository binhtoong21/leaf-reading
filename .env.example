# Tra từ bằng AI (tùy chọn). Sao chép file này thành .env rồi điền, sau đó khởi động lại app.
# Dùng được với mọi nhà cung cấp hỗ trợ chuẩn OpenAI /chat/completions.
# Ví dụ Gemini:      LOOKUP_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Ví dụ OpenRouter:  LOOKUP_BASE_URL=https://openrouter.ai/api/v1
# Ví dụ Ollama local: LOOKUP_BASE_URL=http://127.0.0.1:11434/v1  (không cần API key)
LOOKUP_BASE_URL=
LOOKUP_API_KEY=
LOOKUP_MODEL=
# Số lượt gọi AI tối đa mỗi ngày (tra lại mục đã cache không tính).
LOOKUP_DAILY_LIMIT=100
# Giới hạn token trả lời. Đặt 0 nếu nhà cung cấp không chấp nhận max_tokens.
LOOKUP_MAX_TOKENS=2000
