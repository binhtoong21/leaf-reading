{
  "name": "leaf-reading",
  "productName": "Leaf",
  "version": "1.0.0",
  "description": "Personal local reading notebook",
  "author": "binhtoong21",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/binhtoong21/leaf-reading.git"
  },
  "homepage": "https://github.com/binhtoong21/leaf-reading#readme",
  "bugs": {
    "url": "https://github.com/binhtoong21/leaf-reading/issues"
  },
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "node server/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "app": "npm run build && electron .",
    "icon": "node scripts/make-icon.mjs",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "keywords": [],
  "license": "MIT",
  "devDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@resvg/resvg-js": "2.6.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "45.3.3",
    "electron-builder": "26.18.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "local.leaf.reading",
    "productName": "Leaf",
    "publish": null,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "server/index.mjs",
      "server/store.mjs",
      "server/lookup.mjs",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "Leaf-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Leaf"
    }
  }
}
